# Canonical .dockerignore for a fleet pnpm-workspace app. Copy to the
# repo root as `.dockerignore`. Keeps the build context small and the
# install layer cache-stable. pnpm downloads use a BuildKit cache mount;
# lockfiles, workspace configuration and patches stay in the context.
.git
.github
.forgejo
.gitea
**/node_modules
**/dist
**/build
**/storybook-static
**/coverage
**/__screenshots__
**/__snapshots__
*.log
.env
.env.*
!.env.example

.pnpm-store
.turbo
