{
  "name": "@charcuterie/vite-config",
  "version": "1.0.1",
  "description": "A shared Vite config factory for the Charcuterie fleet — call createViteConfig(overrides) and add your own plugins.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./*": "./src/*"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "vite": ">=5"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sawtaytoes/charcuterie.git",
    "directory": "packages/vite-config"
  }
}
