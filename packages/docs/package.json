{
  "name": "@charcuterie/docs",
  "version": "0.0.0",
  "private": true,
  "description": "Storybook host. Private — the fleet reads it, nobody installs it.",
  "type": "module",
  "scripts": {
    "build:storybook": "storybook build --config-dir .storybook",
    "smoke:storybook": "node scripts/smokeStorybook.ts",
    "storybook": "storybook dev -p 6006 --config-dir .storybook",
    "test:storybook": "vitest run --config vitest.storybook.config.ts",
    "test:ui-dom": "vitest run --config vitest.ui.config.ts",
    "typecheck": "tsc --noEmit",
    "vrt:capture": "node scripts/vrtCapture.mjs",
    "vrt:compare": "reg-suit run",
    "vrt:notify": "node scripts/vrtReportStatus.mjs"
  },
  "dependencies": {
    "@charcuterie/storybook-config": "workspace:*",
    "@charcuterie/tokens": "workspace:*",
    "@charcuterie/ui": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^10.3.6",
    "@storybook/addon-docs": "^10.3.6",
    "@storybook/addon-vitest": "^10.3.6",
    "@storybook/react": "^10.3.6",
    "@storybook/react-vite": "^10.3.6",
    "@tailwindcss/vite": "^4.3.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "6.0.1",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "playwright": "^1.61.1",
    "reg-keygen-git-hash-plugin": "^0.14.2",
    "reg-publish-s3-plugin": "^0.14.2",
    "reg-suit": "^0.14.2",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.3.6",
    "storybook-addon-pseudo-states": "^10.5.5",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
