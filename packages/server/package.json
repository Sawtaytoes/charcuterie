{
  "name": "@charcuterie/server",
  "version": "0.2.0",
  "description": "The fleet's Node server kit — Hono static-asset handler, and MQTT cmd/resp.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./vite": {
      "source": "./src/vite/index.ts",
      "types": "./dist/vite/index.d.ts",
      "default": "./dist/vite/index.js"
    },
    "./mqtt": {
      "source": "./src/mqtt/index.ts",
      "types": "./dist/mqtt/index.d.ts",
      "default": "./dist/mqtt/index.js"
    },
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepack": "yarn build",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@hono/node-server": ">=1.13",
    "hono": ">=4",
    "mqtt": ">=5",
    "vite": ">=5"
  },
  "peerDependenciesMeta": {
    "mqtt": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "devDependencies": {
    "@hono/node-server": "^2.0.2",
    "@types/node": "^25.6.2",
    "hono": "^4.12.21",
    "mqtt": "^5.15.2",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sawtaytoes/charcuterie.git",
    "directory": "packages/server"
  }
}
