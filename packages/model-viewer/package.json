    "src",
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "node build.js",
    "prepack": "yarn build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@types/three": "0.160.0",
    "three": "0.160.0"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "esbuild": "0.28.1",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sawtaytoes/charcuterie.git",
    "directory": "packages/model-viewer"
  }
