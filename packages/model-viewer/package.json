{
  "name": "@charcuterie/model-viewer",
  "version": "0.2.0",
  "description": "Reusable Three.js model review, standalone previews and a local preview service.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    }
  },
