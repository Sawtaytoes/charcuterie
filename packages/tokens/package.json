{
  "name": "@charcuterie/tokens",
  "version": "0.0.0",
  "description": "Design tokens for the Charcuterie component library. Zero dependencies, no React.",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./epaper": {
      "source": "./src/epaper.ts",
      "types": "./dist/epaper.d.ts",
      "default": "./dist/epaper.js"
    },
    "./theme.css": "./dist/theme.css",
    "./fonts.css": "./dist/fonts.css",
    "./fonts/*": "./dist/fonts/*",
    "./variables.css": "./dist/variables.css",
    "./tokens.json": "./dist/tokens.json",
    "./src/*": "./src/*"
  },
  "files": [
    "dist",
    "fonts",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/buildTokens.ts && node scripts/copyFonts.ts",
    "build:tokens": "node scripts/buildTokens.ts",
    "check:contrast": "node scripts/checkContrast.ts",
    "fetch:fonts": "node scripts/fetchFonts.ts",
    "prepack": "yarn build",
    "preview:themes": "node scripts/buildPreview.ts",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^25.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sawtaytoes/charcuterie.git",
    "directory": "packages/tokens"
  }
}
