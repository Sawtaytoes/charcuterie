{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    // M3 is where JSX arrives — `packages/logic` deliberately has
    // none, so its conformance harness can mount the same host
    // under React and Preact without a transform.
    "jsx": "react-jsx",
    "types": ["node"],
    "noEmit": true
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "scripts/*.ts",
    "*.ts"
  ]
}
