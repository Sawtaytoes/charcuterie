{
  "name": "@charcuterie/ui",
  "version": "4.21.0",
  "description": "The Charcuterie components. Tokens for look, @charcuterie/logic for state, ARIA that agents can actually drive.",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./markdown-editor-codemirror": {
      "source": "./src/markdownEditorCodeMirror/index.ts",
      "types": "./dist/markdownEditorCodeMirror/index.d.ts",
      "default": "./dist/markdownEditorCodeMirror/index.js"
    },
    "./react-router": {
      "source": "./src/reactRouter/index.ts",
      "types": "./dist/reactRouter/index.d.ts",
      "default": "./dist/reactRouter/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./testing": {
      "source": "./src/testing/index.ts",
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./tokens": {
      "source": "./src/tokens.ts",
      "types": "./dist/tokens.d.ts",
      "default": "./dist/tokens.js"
    },
    "./src/*": "./src/*",
    "./html-editor": {
      "source": "./src/htmlEditor/index.ts",
      "types": "./dist/htmlEditor/index.d.ts",
      "default": "./dist/htmlEditor/index.js"
    },
    "./html-view": {
      "source": "./src/htmlEditor/view.ts",
      "types": "./dist/htmlEditor/view.d.ts",
      "default": "./dist/htmlEditor/view.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/copyStyles.ts",
    "prepack": "yarn build",
    "test": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@charcuterie/logic": "workspace:*",
    "@charcuterie/tokens": "workspace:*",
    "@floating-ui/react": "^0.27.20",
    "@tanstack/react-virtual": "^3.13.12",
    "tailwind-merge": "^3.6.0"
  },
  "peerDependencies": {
    "@codemirror/commands": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/language": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/common": "^1",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "parse5": "^8.0.1",
    "react": ">=19",
    "react-dom": ">=19",
    "react-router": ">=7"
  },
  "peerDependenciesMeta": {
    "@codemirror/commands": {
      "optional": true
    },
    "@codemirror/lang-markdown": {
      "optional": true
    },
    "@codemirror/language": {
      "optional": true
    },
    "@codemirror/state": {
      "optional": true
    },
    "@codemirror/view": {
      "optional": true
    },
    "@lezer/common": {
      "optional": true
    },
    "@tiptap/core": {
      "optional": true
    },
    "@tiptap/extension-image": {
      "optional": true
    },
    "@tiptap/extension-text-align": {
      "optional": true
    },
    "@tiptap/extension-text-style": {
      "optional": true
    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "parse5": {
      "optional": true
    },
    "react-router": {
      "optional": true
    }
  },
  "devDependencies": {
    "@charcuterie/storybook-config": "workspace:*",
    "@charcuterie/vitest-config": "workspace:^",
    "@codemirror/commands": "^6",
    "@codemirror/lang-markdown": "^6",
    "@codemirror/language": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@lezer/common": "^1",
    "@storybook/react": "^10.3.6",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-image": "^3.31.4",
    "@tiptap/extension-text-align": "^3.31.4",
    "@tiptap/extension-text-style": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "parse5": "^8.0.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^8.3.0",
    "storybook": "^10.3.6",
    "tailwindcss": "^4.3.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sawtaytoes/charcuterie.git",
    "directory": "packages/ui"
  }
}
