{
  "name": "@charcuterie/vitest-config",
  "version": "1.2.0",
  "description": "A shared Vitest config factory for the Charcuterie fleet — call createVitestConfig(overrides) instead of hand-rolling vitest.config.ts.",
  "license": "MIT",
  "type": "module",
  "main": "./src/index.js",
  "types": "./src/index.d.ts",
  "exports": {
    ".": {
      "types": "./src/index.d.ts",
      "default": "./src/index.js"
    },
    "./check-optimize-deps": {
      "types": "./src/checkOptimizeDeps.d.ts",
      "default": "./src/checkOptimizeDeps.js"
    },
    "./*": "./src/*"
  },
  "files": [
    "src"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@testing-library/dom": ">=9",
    "@vitest/browser": ">=3",
    "@vitest/browser-playwright": ">=3",
    "playwright": ">=1.40",
    "vitest": ">=3"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@types/node": "^25.6.2",
    "@vitest/browser": "^4.1.8",
    "@vitest/browser-playwright": "^4.1.8",
    "playwright": "^1.61.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sawtaytoes/charcuterie.git",
    "directory": "packages/vitest-config"
  },
  "bin": {
    "charcuterie-check-optimize-deps": "./src/cli/checkOptimizeDeps.js"
  },
  "peerDependenciesMeta": {
    "@testing-library/dom": {
      "optional": true
    }
  }
}
