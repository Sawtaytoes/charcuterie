{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "types": ["node"],
    "noEmit": true,
    // The framework-free core and the conformance harness stay
    // JSX-free on purpose: the harness mounts its host with
    // `createElement`, so one test file runs under both React and
    // Preact with no transform. JSX is confined to the React-only
    // bindings that legitimately want it (`./query`'s provider),
    // via the automatic runtime — which only affects `.tsx` files,
    // so the `.ts` core and the Preact binding are untouched.
    "jsx": "react-jsx",
    "jsxImportSource": "react"
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "*.ts"]
}
