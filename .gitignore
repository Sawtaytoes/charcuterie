*.log
.cache
install-state.gz
packages/*/cypress/screenshots
packages/*/cypress/videos
dist
node_modules
storybook-static

# Visual-regression scratch: reg-suit's working dir and the freshly
# captured "actual" PNGs. Baselines live in Garage S3, never in git
# (that's the whole point — see agentic VRT decision record).
.reg
packages/*/.reg
packages/*/.vrt-actual

# Generated token artifacts — rebuilt by scripts/buildTokens.ts and
# scripts/buildPreview.ts. The M0 winner's board gets promoted into
# docs/previews/ deliberately; the scratch output does not.
packages/tokens/dist
packages/tokens/preview

# tsc incremental state
*.tsbuildinfo

# Vitest browser-mode failure artefacts: a screenshot of the page at
# the moment an assertion failed, written next to the test. Scratch —
# the same convention as the workspace-wide __screenshots__ rule.
__screenshots__
.vitest-attachments

# Claude Code scratch — session state, and the hand-rolled agent worktrees of
# agentic/docs/runbooks/subagent-pr-workflow.md. Never deliverables; kept inside
# the repo so they stay out of the sibling-repo listing the owner browses from a
# tablet.
.claude

# Ad-hoc screenshots and served mock-ups. Scratch, not deliverables —
# the fleet keeps these at a repo root and never commits them.
__screenshots__
