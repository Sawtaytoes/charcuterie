{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["@charcuterie/biome-config"],
  "files": {
    "includes": [
      "./**",
      "!**/dist",
      "!**/node_modules",
      "!**/storybook-static",
      "!.turbo",
      "!docs/previews",
      "!packages/tokens/preview",
